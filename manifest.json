{
  "manifest_version": 3,
  "name": "Cmd+Enter to Send",
  "version": "1.0.0",
  "description": "Claude と ChatGPT で Enter を改行にし、⌘+Enter のときだけ送信します。",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
